{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:psdc:contracts:economics:dispute-case:1",
  "title": "PSDC Settlement Dispute Case",
  "description": "Append-oriented dispute record. Corrections use signed case revisions and compensating settlement entries, never mutation of finalized evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "disputeId", "revision", "batchId", "challenger", "openedAt", "status", "reason", "contestedResources", "evidence", "policyDecision", "signature"],
  "properties": {
    "contractVersion": { "$ref": "urn:psdc:contracts:common:definitions:1#/$defs/contractVersion" },
    "disputeId": { "$ref": "urn:psdc:contracts:common:definitions:1#/$defs/uuid" },
    "revision": { "type": "integer", "minimum": 1 },
    "batchId": { "$ref": "urn:psdc:contracts:common:definitions:1#/$defs/uuid" },
    "challenger": { "$ref": "urn:psdc:contracts:common:definitions:1#/$defs/resourceRef" },
    "openedAt": { "type": "string", "format": "date-time" },
    "responseDueAt": { "type": "string", "format": "date-time" },
    "resolvedAt": { "type": "string", "format": "date-time" },
    "status": { "enum": ["open", "evidence_requested", "under_review", "upheld", "rejected", "withdrawn", "expired"] },
    "reason": { "$ref": "urn:psdc:contracts:common:definitions:1#/$defs/reason" },
    "contestedResources": { "type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": { "$ref": "urn:psdc:contracts:common:definitions:1#/$defs/resourceRef" } },
    "evidence": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "$ref": "urn:psdc:contracts:common:definitions:1#/$defs/evidenceRef" } },
    "resolution": {
      "type": "object", "additionalProperties": false, "required": ["outcome", "reasonCode"],
      "properties": {
        "outcome": { "enum": ["upheld", "rejected", "withdrawn", "expired"] },
        "reasonCode": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$" },
        "compensatingBatchId": { "$ref": "urn:psdc:contracts:common:definitions:1#/$defs/uuid" }
      }
    },
    "policyDecision": { "$ref": "urn:psdc:contracts:common:definitions:1#/$defs/policyDecisionRef" },
    "signature": { "$ref": "urn:psdc:contracts:common:definitions:1#/$defs/signature" }
  },
  "allOf": [
    { "if": { "properties": { "status": { "enum": ["upheld", "rejected", "withdrawn", "expired"] } }, "required": ["status"] }, "then": { "required": ["resolvedAt", "resolution"] } }
  ]
}
