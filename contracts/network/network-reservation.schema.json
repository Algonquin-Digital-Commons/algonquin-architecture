{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:psdc:contracts:network:reservation:1",
  "title": "PSDC Network Reservation",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "reservationId", "pathId", "leaseId", "workloadId", "status", "generation", "issuedAt", "activateBy", "expiresAt", "bandwidthMbps", "qosClass", "sourceZoneId", "destinationZoneId", "policyDecision", "signature"],
  "properties": {
    "contractVersion": { "$ref": "urn:psdc:contracts:common:definitions:1#/$defs/contractVersion" },
    "reservationId": { "$ref": "urn:psdc:contracts:common:definitions:1#/$defs/uuid" },
    "pathId": { "$ref": "urn:psdc:contracts:common:definitions:1#/$defs/boundedId" },
    "leaseId": { "$ref": "urn:psdc:contracts:common:definitions:1#/$defs/uuid" },
    "workloadId": { "$ref": "urn:psdc:contracts:common:definitions:1#/$defs/uuid" },
    "status": { "enum": ["issued", "active", "released", "expired", "revoked", "failed"] },
    "generation": { "type": "integer", "minimum": 1 },
    "issuedAt": { "type": "string", "format": "date-time" },
    "activateBy": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "terminalAt": { "type": "string", "format": "date-time" },
    "bandwidthMbps": { "type": "integer", "minimum": 1 },
    "qosClass": { "enum": ["best_effort", "interactive", "bulk", "latency_sensitive", "hpc"] },
    "sourceZoneId": { "$ref": "urn:psdc:contracts:common:definitions:1#/$defs/boundedId" },
    "destinationZoneId": { "$ref": "urn:psdc:contracts:common:definitions:1#/$defs/boundedId" },
    "policyDecision": { "$ref": "urn:psdc:contracts:common:definitions:1#/$defs/policyDecisionRef" },
    "reason": { "$ref": "urn:psdc:contracts:common:definitions:1#/$defs/reason" },
    "signature": { "$ref": "urn:psdc:contracts:common:definitions:1#/$defs/signature" }
  },
  "allOf": [
    { "if": { "properties": { "status": { "enum": ["released", "expired", "revoked", "failed"] } }, "required": ["status"] }, "then": { "required": ["terminalAt", "reason"] } }
  ]
}
