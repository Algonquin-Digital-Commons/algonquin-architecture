{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:psdc:contracts:events:event-envelope:1",
  "title": "PSDC Event Envelope",
  "description": "CloudEvents 1.0-compatible at-least-once event envelope with explicit institution, classification, causality, ordering, idempotency, and expiry metadata.",
  "type": "object",
  "additionalProperties": false,
  "required": ["specversion", "id", "source", "type", "time", "datacontenttype", "dataschema", "institutionid", "classification", "schemaversion", "correlationid", "sequence", "orderingscope", "idempotencykey", "data"],
  "properties": {
    "specversion": { "const": "1.0" },
    "id": { "$ref": "urn:psdc:contracts:common:definitions:1#/$defs/uuid" },
    "source": { "type": "string", "format": "uri-reference", "maxLength": 2048 },
    "type": { "type": "string", "pattern": "^org\\.psdc\\.[a-z0-9.-]+\\.v[1-9][0-9]*$", "maxLength": 255 },
    "subject": { "type": "string", "minLength": 1, "maxLength": 512 },
    "time": { "type": "string", "format": "date-time" },
    "datacontenttype": { "const": "application/json" },
    "dataschema": { "type": "string", "pattern": "^urn:psdc:contracts:" },
    "institutionid": { "$ref": "urn:psdc:contracts:common:definitions:1#/$defs/institutionId" },
    "classification": { "$ref": "urn:psdc:contracts:common:definitions:1#/$defs/dataClassification" },
    "schemaversion": { "type": "string", "pattern": "^[1-9][0-9]*\\.[0-9]+$" },
    "correlationid": { "$ref": "urn:psdc:contracts:common:definitions:1#/$defs/uuid" },
    "causationid": { "$ref": "urn:psdc:contracts:common:definitions:1#/$defs/uuid" },
    "sequence": { "type": "integer", "minimum": 0 },
    "orderingscope": { "$ref": "urn:psdc:contracts:common:definitions:1#/$defs/boundedId" },
    "idempotencykey": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{16,128}$" },
    "expiresat": { "type": "string", "format": "date-time" },
    "actor": { "$ref": "urn:psdc:contracts:common:definitions:1#/$defs/resourceRef" },
    "data": {}
  }
}
