{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:psdc:contracts:common:definitions:1",
  "title": "PSDC Common Contract Definitions",
  "description": "Shared structural primitives. Validation never grants authorization.",
  "$defs": {
    "contractVersion": { "const": "1.0" },
    "uuid": { "type": "string", "format": "uuid" },
    "institutionId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{2,127}$" },
    "boundedId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,255}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "cid": {
      "type": "string",
      "anyOf": [
        { "pattern": "^b[a-z2-7]{20,200}$" },
        { "pattern": "^Qm[1-9A-HJ-NP-Za-km-z]{44}$" }
      ]
    },
    "dataClassification": {
      "enum": ["public", "internal", "confidential", "restricted", "regulated"]
    },
    "trustTier": {
      "enum": ["development", "pilot", "production", "federated"]
    },
    "backendKind": {
      "enum": ["task", "kubernetes", "openstack", "slurm"]
    },
    "reason": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$" },
        "message": { "type": "string", "minLength": 1, "maxLength": 500 },
        "retryable": { "type": "boolean" },
        "retryAfterSeconds": { "type": "integer", "minimum": 1, "maximum": 86400 }
      }
    },
    "resourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{1,63}$" },
        "id": { "$ref": "#/$defs/boundedId" },
        "version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "digest": { "$ref": "#/$defs/sha256" }
      }
    },
    "policyDecisionRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decisionId", "policyId", "policyVersion", "outcome"],
      "properties": {
        "decisionId": { "$ref": "#/$defs/uuid" },
        "policyId": { "$ref": "#/$defs/boundedId" },
        "policyVersion": { "type": "string", "minLength": 1, "maxLength": 64 },
        "outcome": { "enum": ["allow", "deny"] }
      }
    },
    "resourceQuantity": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "cpuMillis": { "type": "integer", "minimum": 1 },
        "memoryBytes": { "type": "integer", "minimum": 1048576 },
        "gpuCount": { "type": "integer", "minimum": 0 },
        "gpuMemoryBytes": { "type": "integer", "minimum": 0 },
        "ephemeralStorageBytes": { "type": "integer", "minimum": 0 },
        "nodeCount": { "type": "integer", "minimum": 1 }
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "quantity", "unit", "source"],
      "properties": {
        "metric": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]{1,63}$" },
        "quantity": { "type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,9})?$" },
        "unit": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._/-]{0,31}$" },
        "source": { "$ref": "#/$defs/boundedId" }
      }
    },
    "creditAmount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit", "amount"],
      "properties": {
        "unit": { "const": "IRU" },
        "amount": { "type": "string", "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]{1,9})?$" }
      }
    },
    "nonNegativeCreditAmount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit", "amount"],
      "properties": {
        "unit": { "const": "IRU" },
        "amount": { "type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,9})?$" }
      }
    },
    "signature": {
      "type": "object",
      "description": "Signature over RFC 8785 canonical JSON of the root object with the signature member omitted.",
      "additionalProperties": false,
      "required": ["algorithm", "keyId", "canonicalization", "signedAt", "value"],
      "properties": {
        "algorithm": { "enum": ["Ed25519", "ES256", "PS256"] },
        "keyId": { "type": "string", "minLength": 3, "maxLength": 512 },
        "canonicalization": { "const": "RFC8785" },
        "signedAt": { "type": "string", "format": "date-time" },
        "value": { "type": "string", "pattern": "^[A-Za-z0-9_-]{16,2048}$" }
      }
    },
    "labels": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": { "pattern": "^[a-z][a-z0-9./_-]{0,62}$" },
      "additionalProperties": { "type": "string", "maxLength": 128 }
    },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "digest", "classification", "retentionClass"],
      "properties": {
        "uri": { "type": "string", "format": "uri", "maxLength": 2048 },
        "digest": { "$ref": "#/$defs/sha256" },
        "classification": { "$ref": "#/$defs/dataClassification" },
        "retentionClass": { "$ref": "#/$defs/boundedId" }
      }
    }
  }
}
