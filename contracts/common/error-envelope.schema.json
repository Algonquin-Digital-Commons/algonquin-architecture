{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:psdc:contracts:common:error-envelope:1",
  "title": "PSDC Error Envelope",
  "description": "RFC 9457-aligned, privacy-minimized error response. Detail must not contain secrets or protected record contents.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "type", "title", "status", "code", "traceId", "correlationId", "retryable"],
  "properties": {
    "contractVersion": { "$ref": "urn:psdc:contracts:common:definitions:1#/$defs/contractVersion" },
    "type": { "type": "string", "format": "uri", "maxLength": 2048 },
    "title": { "type": "string", "minLength": 1, "maxLength": 160 },
    "status": { "type": "integer", "minimum": 400, "maximum": 599 },
    "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$" },
    "detail": { "type": "string", "maxLength": 1000 },
    "instance": { "type": "string", "format": "uri-reference", "maxLength": 2048 },
    "traceId": { "$ref": "urn:psdc:contracts:common:definitions:1#/$defs/boundedId" },
    "correlationId": { "$ref": "urn:psdc:contracts:common:definitions:1#/$defs/uuid" },
    "retryable": { "type": "boolean" },
    "retryAfterSeconds": { "type": "integer", "minimum": 1, "maximum": 86400 },
    "violations": {
      "type": "array", "maxItems": 64,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["field", "code"],
        "properties": {
          "field": { "type": "string", "pattern": "^/", "maxLength": 512 },
          "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$" },
          "message": { "type": "string", "maxLength": 300 }
        }
      }
    }
  },
  "allOf": [
    { "if": { "properties": { "retryable": { "const": true } }, "required": ["retryable"] }, "then": { "required": ["retryAfterSeconds"] } }
  ]
}
