{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:psdc:contracts:common:state-transition-cases:1",
  "title": "PSDC State Transition Conformance Cases",
  "type": "object",
  "additionalProperties": false,
  "required": ["caseVersion", "cases"],
  "properties": {
    "caseVersion": { "const": "1.0" },
    "cases": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["caseId", "machineId", "kind", "from", "action", "to", "expectedAllowed"],
        "properties": {
          "caseId": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{2,159}$" },
          "machineId": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{2,127}$" },
          "kind": { "enum": ["positive", "negative", "replay"] },
          "from": { "type": "string", "minLength": 1 },
          "action": { "type": "string", "minLength": 3 },
          "to": { "type": "string", "minLength": 1 },
          "expectedAllowed": { "type": "boolean" },
          "expectedReasonCode": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$" },
          "expectedReplayResult": { "enum": ["same_result"] }
        },
        "allOf": [
          { "if": { "properties": { "expectedAllowed": { "const": false } }, "required": ["expectedAllowed"] }, "then": { "required": ["expectedReasonCode"] } },
          { "if": { "properties": { "kind": { "const": "replay" } }, "required": ["kind"] }, "then": { "required": ["expectedReplayResult"] } }
        ]
      }
    }
  }
}
