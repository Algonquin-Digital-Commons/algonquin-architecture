{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:psdc:contracts:security:kms-operation-grant:1",
  "title": "PSDC KMS Operation Grant",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "grantId", "issuerInstitutionId", "subjectId", "keyRef", "operations", "purpose", "context", "notBefore", "expiresAt", "maxUses", "status", "policyDecision", "approvals", "signature"],
  "properties": {
    "contractVersion": { "$ref": "urn:psdc:contracts:common:definitions:1#/$defs/contractVersion" },
    "grantId": { "$ref": "urn:psdc:contracts:common:definitions:1#/$defs/uuid" },
    "issuerInstitutionId": { "$ref": "urn:psdc:contracts:common:definitions:1#/$defs/institutionId" },
    "subjectId": { "$ref": "urn:psdc:contracts:common:definitions:1#/$defs/boundedId" },
    "keyRef": { "$ref": "urn:psdc:contracts:common:definitions:1#/$defs/resourceRef" },
    "operations": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["encrypt", "decrypt", "wrap", "unwrap", "sign", "verify", "derive"] } },
    "purpose": { "type": "string", "minLength": 3, "maxLength": 500, "not": { "pattern": "^\\*$" } },
    "context": {
      "type": "object", "additionalProperties": false, "required": ["institutionId", "dataClassification", "resourceRefs"],
      "properties": {
        "institutionId": { "$ref": "urn:psdc:contracts:common:definitions:1#/$defs/institutionId" },
        "dataClassification": { "$ref": "urn:psdc:contracts:common:definitions:1#/$defs/dataClassification" },
        "resourceRefs": { "type": "array", "minItems": 1, "maxItems": 128, "items": { "$ref": "urn:psdc:contracts:common:definitions:1#/$defs/resourceRef" } },
        "aadDigest": { "$ref": "urn:psdc:contracts:common:definitions:1#/$defs/sha256" }
      }
    },
    "notBefore": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "maxUses": { "type": "integer", "minimum": 1, "maximum": 1000000 },
    "status": { "enum": ["active", "revoked", "expired"] },
    "policyDecision": { "$ref": "urn:psdc:contracts:common:definitions:1#/$defs/policyDecisionRef" },
    "approvals": {
      "type": "array", "minItems": 1, "maxItems": 16,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["approverId", "role", "approvedAt"],
        "properties": {
          "approverId": { "$ref": "urn:psdc:contracts:common:definitions:1#/$defs/boundedId" },
          "role": { "type": "string", "minLength": 2, "maxLength": 128 },
          "approvedAt": { "type": "string", "format": "date-time" }
        }
      }
    },
    "revocation": {
      "type": "object", "additionalProperties": false, "required": ["revokedAt", "reason"],
      "properties": {
        "revokedAt": { "type": "string", "format": "date-time" },
        "reason": { "$ref": "urn:psdc:contracts:common:definitions:1#/$defs/reason" }
      }
    },
    "signature": { "$ref": "urn:psdc:contracts:common:definitions:1#/$defs/signature" }
  },
  "allOf": [
    { "if": { "properties": { "status": { "const": "revoked" } }, "required": ["status"] }, "then": { "required": ["revocation"] } }
  ]
}
