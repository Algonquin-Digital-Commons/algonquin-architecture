{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:psdc:contracts:compute:provider:1",
  "title": "PSDC Compute Provider",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "providerId", "institutionId", "displayName", "providerType", "authorityDid", "status", "trustTier", "scopes", "sequence", "issuedAt", "expiresAt", "endpoints", "signature"],
  "properties": {
    "contractVersion": { "$ref": "urn:psdc:contracts:common:definitions:1#/$defs/contractVersion" },
    "providerId": { "$ref": "urn:psdc:contracts:common:definitions:1#/$defs/boundedId" },
    "institutionId": { "$ref": "urn:psdc:contracts:common:definitions:1#/$defs/institutionId" },
    "displayName": { "type": "string", "minLength": 1, "maxLength": 200 },
    "providerType": { "enum": ["campus", "federated_partner", "approved_commercial", "public_adapter"] },
    "authorityDid": { "type": "string", "pattern": "^did:[a-z0-9]+:[A-Za-z0-9._:%-]+$", "maxLength": 512 },
    "status": { "enum": ["pending", "active", "suspended", "revoked", "retired"] },
    "trustTier": { "$ref": "urn:psdc:contracts:common:definitions:1#/$defs/trustTier" },
    "scopes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["compute", "storage", "network"] } },
    "sequence": { "type": "integer", "minimum": 1 },
    "issuedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "endpoints": {
      "type": "array", "minItems": 1, "maxItems": 16,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["kind", "uri"],
        "properties": {
          "kind": { "enum": ["capability", "offer", "lease", "worker", "evidence", "federation"] },
          "uri": { "type": "string", "format": "uri", "maxLength": 2048 }
        }
      }
    },
    "policyRefs": { "type": "array", "maxItems": 32, "items": { "$ref": "urn:psdc:contracts:common:definitions:1#/$defs/resourceRef" } },
    "revocation": {
      "type": "object", "additionalProperties": false, "required": ["revokedAt", "reason"],
      "properties": {
        "revokedAt": { "type": "string", "format": "date-time" },
        "reason": { "$ref": "urn:psdc:contracts:common:definitions:1#/$defs/reason" },
        "replacedByProviderId": { "$ref": "urn:psdc:contracts:common:definitions:1#/$defs/boundedId" }
      }
    },
    "labels": { "$ref": "urn:psdc:contracts:common:definitions:1#/$defs/labels" },
    "signature": { "$ref": "urn:psdc:contracts:common:definitions:1#/$defs/signature" }
  },
  "allOf": [
    { "if": { "properties": { "status": { "const": "revoked" } }, "required": ["status"] }, "then": { "required": ["revocation"] } }
  ]
}
