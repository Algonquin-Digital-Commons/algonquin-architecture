{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:psdc:contracts:compute:classification-record:1",
  "title": "PSDC Workload Classification Record",
  "description": "Immutable classifier output used as an input to policy admission; it does not itself authorize placement.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "classificationId", "workloadId", "manifestDigest", "classifierId", "classifierVersion", "classifiedAt", "workloadClass", "dataClassification", "eligibleBackends", "institutionScope", "riskLevel", "evidenceDigest", "signature"],
  "properties": {
    "contractVersion": { "$ref": "urn:psdc:contracts:common:definitions:1#/$defs/contractVersion" },
    "classificationId": { "$ref": "urn:psdc:contracts:common:definitions:1#/$defs/uuid" },
    "workloadId": { "$ref": "urn:psdc:contracts:common:definitions:1#/$defs/uuid" },
    "manifestDigest": { "$ref": "urn:psdc:contracts:common:definitions:1#/$defs/sha256" },
    "classifierId": { "$ref": "urn:psdc:contracts:common:definitions:1#/$defs/boundedId" },
    "classifierVersion": { "type": "string", "minLength": 1, "maxLength": 64 },
    "classifiedAt": { "type": "string", "format": "date-time" },
    "workloadClass": { "enum": ["opportunistic_task", "independent_task_graph", "parameter_sweep", "container_service", "vm", "hpc_mpi", "ai_inference", "ai_service", "critical_service"] },
    "dataClassification": { "$ref": "urn:psdc:contracts:common:definitions:1#/$defs/dataClassification" },
    "eligibleBackends": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "urn:psdc:contracts:common:definitions:1#/$defs/backendKind" } },
    "institutionScope": { "enum": ["local_only", "approved_federation", "approved_external"] },
    "riskLevel": { "enum": ["low", "moderate", "high", "prohibited"] },
    "constraints": { "type": "array", "uniqueItems": true, "maxItems": 64, "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$" } },
    "evidenceDigest": { "$ref": "urn:psdc:contracts:common:definitions:1#/$defs/sha256" },
    "signature": { "$ref": "urn:psdc:contracts:common:definitions:1#/$defs/signature" }
  }
}
